# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Phone parsing -----------------------------------------------------------
# ISO 3166-1 alpha-2, uppercase. There is deliberately NO fallback:
# resolveDefaultCountry() throws when unset or unsupported, because a wrong
# silent default normalizes guests into the wrong country and locks them out of
# their own invitation at the phone gate.
DEFAULT_PHONE_COUNTRY=CO

# --- Supabase ----------------------------------------------------------------
# Local development values come from `supabase status`.
# SUPABASE_SECRET_KEY maps to service_role and MUST NEVER be prefixed
# NEXT_PUBLIC_. It bypasses RLS; if it reaches the browser, every guest phone
# number goes with it.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Secrets (minimum 32 characters each) ------------------------------------
# Generate with: openssl rand -hex 32
# UNLOCK_COOKIE_SECRET signs the cookie that keeps an unlocked guest unlocked.
# GATE_IP_PEPPER is hashed with the client IP so stored rate-limit rows carry
# no recoverable address.
UNLOCK_COOKIE_SECRET=
GATE_IP_PEPPER=

# --- Site --------------------------------------------------------------------
# Absolute HTTPS origin, no trailing path. Used as metadataBase so og:image
# resolves to the absolute URL WhatsApp requires; a relative URL yields no
# preview card at all.
NEXT_PUBLIC_SITE_ORIGIN=

# --- Console operator auth --------------------------------------------------
# The publishable key (browser-safe). The middleware and the sign-in action act
# AS the signed-in operator, so they must NOT hold the secret key.
#
# Operator accounts are email + password, created once by
# `npm run seed:operators`. There is no sign-up and no self-service reset: a
# forgotten password is a maintainer re-running that script.
SUPABASE_PUBLISHABLE_KEY=
# HMAC key for the operator identity the middleware forwards on the REQUEST
# headers. Generate with: openssl rand -hex 32
OPERATOR_SESSION_SECRET=
