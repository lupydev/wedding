exports[`InvitationBody > matches its approved markup 1`] = `"<article class="invitation"><p class="invitation__couple">{{COUPLE_NAMES}}</p><h1 class="invitation__greeting">Ñoño Muñóz</h1><p class="invitation__lead">Nos alegra mucho invitarlos a celebrar nuestro matrimonio.</p><dl class="invitation__details"><dt>Fecha</dt><dd>{{WEDDING_DATE}}</dd><dt>Lugar</dt><dd>{{VENUE_NAME}}</dd><dt>Dirección</dt><dd>{{VENUE_ADDRESS}}</dd></dl><section class="invitation__household"><h2>Esta invitación es para Familia Muñóz</h2><p>Tienen 3 lugares reservados.</p><ul><li>Ñoño Muñóz</li><li>Aurelia Muñóz</li><li>Tomás Muñóz (niño o niña)</li></ul></section><p class="invitation__deadline">Confirmen su asistencia antes del 2027-05-01.</p></article>"`;
