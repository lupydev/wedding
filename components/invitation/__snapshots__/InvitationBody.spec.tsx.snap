exports[`InvitationBody > matches its approved markup 1`] = `"<article class="invitation"><p class="invitation__couple">Ana y Bruno</p><h1 class="invitation__greeting">Ñoño Muñóz</h1><p class="invitation__lead">Nos alegra mucho invitarlos a celebrar nuestro matrimonio.</p><dl class="invitation__details"><dt>Fecha</dt><dd>sábado 14 de noviembre de 2026</dd><dt>Lugar</dt><dd>Hacienda La Ñapa</dd><dt>Dirección</dt><dd>Calle 12 #34-56, Barrio Centro</dd></dl><section class="invitation__household"><h2>Esta invitación es para Familia Muñóz</h2><p>Tienen 3 lugares reservados.</p><ul><li>Ñoño Muñóz</li><li>Aurelia Muñóz</li><li>Tomás Muñóz (niño o niña)</li></ul></section><p class="invitation__deadline">Confirmen su asistencia antes del 2027-05-01.</p></article>"`;

